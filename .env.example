# API Keys for Misinformation Detection Pipeline
# Replace placeholders with your actual keys before running

OPENAI_API_KEY=your_openai_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Optional: Langtrace API key for execution tracing & observability
LANGTRACE_API_KEY=your_langtrace_api_key_here

# Optional: Preferred OpenAI model (defaults to gpt-4o or gpt-4.1)
OPENAI_MODEL_NAME=gpt-4o

# Optional: OpenRouter configuration (alternative to direct OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-6-luna
